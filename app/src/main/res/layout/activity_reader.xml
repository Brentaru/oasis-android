<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/oasis_background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/oasis_nav"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <TextView
            android:id="@+id/buttonBack"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/bg_oasis_ghost"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:text="Back"
            android:textColor="@color/oasis_text_secondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/textviewReaderTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="Loading..."
            android:textColor="@color/oasis_text_primary"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:background="@drawable/bg_oasis_chip"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="4dp">

        <TextView
            android:id="@+id/buttonVerticalMode"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:background="@drawable/bg_oasis_primary"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:text="Vertical"
            android:textColor="@color/white"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/buttonPageMode"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:text="Page"
            android:textColor="@color/oasis_muted"
            android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="10dp">

        <LinearLayout
            android:id="@+id/readerPages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textviewReaderState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_oasis_chip"
                android:gravity="center"
                android:padding="18dp"
                android:text="Loading chapter pages..."
                android:textColor="@color/oasis_muted"
                android:textSize="14sp" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/pageControls"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@color/oasis_background"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="8dp"
        android:visibility="gone">

        <Button
            android:id="@+id/buttonPreviousPage"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_oasis_ghost"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="&lt;"
            android:textAllCaps="false"
            android:textColor="@color/oasis_text_secondary"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/textviewPageIndicator"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_marginHorizontal="8dp"
            android:background="@drawable/bg_oasis_chip"
            android:gravity="center"
            android:paddingHorizontal="14dp"
            android:text="Page 1 / 1"
            android:textColor="@color/oasis_text_muted"
            android:textSize="12sp" />

        <Button
            android:id="@+id/buttonNextPage"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_oasis_ghost"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="&gt;"
            android:textAllCaps="false"
            android:textColor="@color/oasis_text_secondary"
            android:textSize="16sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/oasis_outline" />

    <LinearLayout
        android:id="@+id/chapterFooter"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/oasis_surface"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="10dp">

        <Button
            android:id="@+id/buttonPreviousChapter"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:background="@drawable/bg_oasis_ghost"
            android:text="Previous chapter"
            android:textAllCaps="false"
            android:textColor="@color/oasis_muted"
            android:textSize="13sp" />

        <Button
            android:id="@+id/buttonNextChapter"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_oasis_primary"
            android:text="Next chapter"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
