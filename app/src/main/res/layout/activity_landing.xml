<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/oasis_background"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <ImageView
        android:layout_width="78dp"
        android:layout_height="78dp"
        android:contentDescription="Oasis"
        android:src="@drawable/ic_oasis_mark" />

    <TextView
        android:layout_width="260dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:text="Oasis"
        android:textColor="@color/oasis_purple"
        android:textSize="44sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="Read, save, and continue manga from your library."
        android:textColor="@color/oasis_text_secondary"
        android:textSize="14sp" />

    <Button
        android:id="@+id/buttonLogin"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="34dp"
        android:background="@drawable/bg_oasis_primary"
        android:text="Login"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="14sp" />

    <Button
        android:id="@+id/buttonRegister"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_oasis_ghost"
        android:text="Register"
        android:textAllCaps="false"
        android:textColor="@color/oasis_text_secondary"
        android:textSize="14sp" />
</LinearLayout>
