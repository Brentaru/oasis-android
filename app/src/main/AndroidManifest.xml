<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".app.CustomApp"
        android:allowBackup="true"
        android:usesCleartextTraffic="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/oasis_logo_mark"
        android:label="@string/app_name"
        android:roundIcon="@drawable/oasis_logo_mark"
        android:supportsRtl="true"
        android:theme="@style/Theme.Oasis"
        tools:targetApi="31">
        <activity
            android:name=".screens.register.RegisterActivity"
            android:exported="false" />
        <activity
            android:name=".screens.landing.LandingActivity"
            android:exported="false" />
        <activity
            android:name=".screens.series.SeriesDetailsActivity"
            android:exported="false" />
        <activity
            android:name=".screens.reader.ReaderActivity"
            android:exported="false" />
        <activity
            android:name=".screens.browse.BrowseActivity"
            android:exported="false" />
        <activity
            android:name=".screens.library.LibraryActivity"
            android:exported="false" />
        <activity
            android:name=".screens.profile.ProfileActivity"
            android:exported="false" />
        <activity
            android:name=".screens.home.HomeActivity"
            android:exported="false" />
        <activity
            android:name=".screens.login.LoginActivity"
            android:exported="false" />
        <activity
            android:name=".screens.splash.SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
